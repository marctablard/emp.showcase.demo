{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["reflect-metadata", "jest"], // Required for InversifyJS
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "experimentalDecorators": true, // Required for InversifyJS
    "emitDecoratorMetadata": true, // Required for InversifyJS
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@platform/*": ["./src/platform/*"],
      "@extensions/*": ["./extensions/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // Next 16.3 typechecks the full include graph during `next build`.
    // Jest owns unit/component tests; Playwright owns e2e.
    "**/*.test.ts",
    "**/*.test.tsx",
    "e2e"
  ]
}
