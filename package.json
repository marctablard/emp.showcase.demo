    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "^15.3.5",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^10.4.5",
    "husky": "^9.1.7",
    "ignore-loader": "^0.1.2",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lint-staged": "^16.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5"
  },
  "optionalDependencies": {
