{
  "name": "emporix-showcase",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel generate:watch dev:next dev:open-browser",
    "dev:next": "next dev",
    "dev:open-browser": "ts-node --project scripts/tsconfig.json scripts/open-browser.ts",
    "dev:https": "npm-run-all --parallel generate:watch dev:next:https",
    "dev:next:https": "next dev --experimental-https",
    "build": "npm run generate && next build && npm run check-translations && npm run lint",
    "build:next": "next build",
    "check-translations": "ts-node --project scripts/tsconfig.json scripts/check-translations.ts",
    "check-translations:all": "ts-node --project scripts/tsconfig.json scripts/check-translations.ts --locales allLanguages",
    "check-translations:strict": "ts-node --project scripts/tsconfig.json scripts/check-translations.ts --locales allLanguages --strict",
    "generate": "ts-node --project scripts/tsconfig.json scripts/di-generator.ts",
    "generate:watch": "ts-node --project scripts/tsconfig.json scripts/di-generator.ts --watch",
    "start": "next start",
    "lint": "eslint",
    "test": "npm-run-all --parallel jest e2e",
    "jest": "jest --runInBand",
    "jest:watch": "jest --watch",
    "jest:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "format": "prettier --write \"**/*.{tsx,jsx,ts,css,scss,md}\"",
    "setup": "ts-node --project scripts/tsconfig.json scripts/setup-api.ts",
    "generate:sso-password": "ts-node --project scripts/tsconfig.json scripts/generate-sso-password.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@lucide/lab": "^0.1.2",
    "@next/env": "^16.0.6",
    "@preact/signals-react": "^3.3.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@storyblok/react": "^5.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.3",
    "embla-carousel-react": "^8.6.0",
    "immer": "^10.2.0",
    "inversify": "^7.10.4",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.23",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "next": "^16.0.7",
    "next-api-decorators": "^2.0.2",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.4.0",
    "next-intl-split": "^1.2.9",
    "next-themes": "^0.4.6",
    "openmeteo": "^1.2.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^7.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-grid-layout": "^1.5.2",
    "react-hook-form": "^7.66.0",
    "react-redux": "^9.2.0",
    "react-sizeme": "^3.0.2",
    "recharts": "^2.15.3",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.2",
    "universal-cookie": "^8.0.1",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
