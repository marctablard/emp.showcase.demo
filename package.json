    "@radix-ui/react-tooltip": "^1.2.7",
    "@storyblok/react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "immer": "^10.1.1",
    "inversify": "^7.5.1",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "lucide-react": "^0.510.0",
    "motion": "^12.23.12",
    "next": "^15.5.2",
    "next-api-decorators": "^2.0.2",
    "next-auth": "5.0.0-beta.29",
    "next-intl": "^4.1.0",
    "next-intl-split": "^1.2.8",
    "next-themes": "^0.4.6",
    "openmeteo": "^1.2.0",
    "rate-limiter-flexible": "^7.2.0",
    "react": "^19.0.0",
