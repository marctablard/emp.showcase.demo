    "@swc/core-linux-x64-gnu": "^1.0.0",
    "@swc/core-linux-x64-musl": "^1.0.0",
    "@tailwindcss/oxide-linux-arm64-musl": "^4.0.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.0",
    "@tailwindcss/oxide-linux-x64-musl": "^4.0.0",
    "lightningcss-linux-arm64-musl": "^1.0.0",
    "lightningcss-linux-x64-gnu": "^1.0.0",
    "lightningcss-linux-x64-musl": "^1.0.0"
  }
}
