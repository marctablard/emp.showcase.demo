# Supply-chain: only resolve versions published at least N days ago.
# Next.js uses pnpm's `minimumReleaseAge` in its own repo; for this npm-based repo
# the current equivalent is npm's `min-release-age` (npm >=11.10).
# https://docs.npmjs.com/cli/v11/using-npm/config#min-release-age
min-release-age=7

# New dependency entries in package.json omit semver ranges (^ / ~).
save-exact=true
