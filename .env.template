NEXT_PUBLIC_NOTIFICATION_POLLING_INTERVAL_SECONDS=30
NEXT_PUBLIC_DISABLE_PUSH_NOTIFICATIONS=true

# Setup Steps
# ---------
# Optional
# You can add custom Setups steps to setup your own Tenant, a few are provided OOTB
# See ./scripts/setup
NEXT_SETUP_STEP_SERVICES=NotificationSetupStepService

# Cache Middleware
# --------------
# Optional
# Enable/disable cache middleware (default: true)
NEXT_CACHE_MIDDLEWARE_ENABLED=true
# Default cache revalidation time in seconds (default: 3600).
# Controls both:
#   - `DEFAULT_CACHE_REVALIDATE` in `src/caching/cache-config.ts`
#     (Cache-Control s-maxage for routes that don't set `cache.revalidate` explicitly)
#   - `DEFAULT_CACHE_REVALIDATE` in `src/platform/integrations/emporix/common/cache-defaults.ts`
#     (opt-in Next fetch cache TTL passed as the trailing `cacheSeconds` arg to Emporix
#      `authenticatedFetch`; applies to GET/HEAD only).
# Non-positive or non-numeric values fall back to 3600.
# The `NEXT_PUBLIC_` prefix is required because the integration module can be
# evaluated from the client DI container graph; non-public env vars resolve to
# `undefined` in the browser bundle and the override would be silently lost.
NEXT_PUBLIC_CACHE_DEFAULT_REVALIDATE=3600

# Build Settings
# ------------
# Optional
# OUTPUT Mode in next.config:
# - undefined/empty : default local development mode
# - standalone : supported for Docker or other Next.js server hosting setups
# - export : unsupported for this application because product pages, middleware, and /api routes require the Next.js server runtime
NEXT_SERVER_OUTPUTMODE=
