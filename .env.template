# Push Notifications
# ---------------
# Optional
# Can be generated through https://vapidkeys.com/
VAPID_CONTACT=mailto:example@support.com
VAPID_PRIVATE_KEY=your_generated_private_vapid_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_generated_public_vapid_key
