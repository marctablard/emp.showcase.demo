# =============================================================================
# SENSITIVE CONFIGURATION (Secrets, Passwords, Private Keys)
# These values should never be committed or shared
# =============================================================================

# Authentication & Security
# ------------------------
# Required
NEXTAUTH_SECRET=your_nextauth_secret

# Optional
# Set this if you want to use accounts that can be logged in through SSO
NEXT_SSO_PASSWORD_SECRET=your_sso_password_secret
NEXT_SETUP_API_SECRET=your_secure_setup_api_secret


# =============================================================================
# ENVIRONMENT-SPECIFIC CONFIGURATION
# Values that vary between environments but aren't sensitive
# =============================================================================

# Base URLs & Endpoints
# -----------------------
# Required - Set the protocol (HTTP/HTTPS) respective to the way you start your server
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Emporix Tenant & Client Configuration
# ------------------------
NEXT_PUBLIC_EMPORIX_BASE_URL=https://api.emporix.io
# Required - Public Storefront API Key (Emporix showcase tenant)
# A demo key is provided for convenience to ease the startup
NEXT_PUBLIC_EMPORIX_TENANT=showcase
NEXT_PUBLIC_EMPORIX_CLIENT_ID=eZKiPpY0THdB22MtNcXDuyTRxRxVZ6sD94baPpGoEeM0S0AR
# Server-side credentials (replace with your own for login/ordering)
NEXT_EMPORIX_CLIENT_ID=your_server_client_id
NEXT_EMPORIX_CLIENT_SECRET=your_server_client_secret
# Optional - The Storefront Client Secret is currently not used in any of the Emporix APIs
# but you can provide it for exposure to third party systems for future purposes
# !!! Security Note: you need to ensure yourself, that you are not exposing critical info through the Browser
NEXT_PUBLIC_EMPORIX_CLIENT_SECRET=your_client_secret_for_public_use

# Optional - Only required for automated API Testing
NEXT_EMPORIX_TEST_BASE_URL=https://api.emporix.io
NEXT_EMPORIX_TEST_TENANT=your_tenant_name
NEXT_EMPORIX_TEST_CLIENT_ID=your_storefront_client_id
NEXT_EMPORIX_TEST_SERVER_CLIENT_ID=your_server_client_id
# Test Environment Secrets
NEXT_EMPORIX_TEST_CLIENT_SECRET=your_storefront_client_secret
NEXT_EMPORIX_TEST_SERVER_CLIENT_SECRET=your_server_client_secret

# Optional - Battery Included
# -----------------------
# A demo key and collection is provided for convenience to ease the startup
NEXT_PUBLIC_BATTERY_INCLUDED_COLLECTION=customer.emporix.demo
NEXT_PUBLIC_BATTERY_INCLUDED_BASE_URL=https://api.batteryincluded.com
NEXT_PUBLIC_BATTERY_INCLUDED_API_KEY=Jv9lBxaYhpr9aKZYB6m8pZjAiiuQgDHe

# Optional - Storyblok
# ------------------------
# A demo key is provided for convenience to ease the startup
NEXT_PUBLIC_STORYBLOK_ACCESS_TOKEN=uvTlxgRrZDSUyr4zftdoNgtt
NEXT_PUBLIC_STORYBLOK_MULTI_SITE=false
NEXT_PUBLIC_STORYBLOK_ACCESS_PREVIEW=true

# =============================================================================
# GENERAL CONFIGURATION
# Default settings and feature flags
# =============================================================================

# System Defaults
# -------------
# Required
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_SITE=main
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_DEFAULT_COUNTRY=DE
NEXT_PUBLIC_DEFAULT_REGION=Europe
NEXT_PUBLIC_EMPORIX_DEFAULT_UNIT_CODE=piece
NEXT_PUBLIC_AVAILABLE_SITES=main,us-branch

# Optional
NEXT_PUBLIC_SITE_ROUTING_CONFIG=default

# Feature Flags & Settings
# ----------------------
# Optional
NEXT_STYLEGUIDE_PAGE=true
NEXT_ROBOTS_NOINDEX=false
NEXT_SETUP_API_ENABLED=false
NEXT_CART_STOCK_CHECK_ENABLED=true

# Debug Settings
# ------------
# Optional
NEXT_PUBLIC_DEBUG_API_CURL=false
NEXT_PUBLIC_DEBUG_API_VERBOSE=false
NEXT_PUBLIC_DEBUG_API_ENDPOINTS=
NEXT_PUBLIC_DEBUG_API_RESPONSE=OFF

# Storage Configuration
# -------------------
# Optional
NEXT_PUBLIC_HISTORY_STORAGE_NAME=history-storage
NEXT_PUBLIC_MAX_SEARCH_HISTORY=10
NEXT_PUBLIC_MAX_LAST_SEEN_PRODUCTS=12

# Rate Limiting
# -----------
# Optional
RATE_LIMIT=60
RATE_WINDOW=60

# Security Headers
# --------------
# Optional
CROSS_ORIGIN_RESOURCE_POLICY=same-site
CROSS_ORIGIN_OPENER_POLICY=same-origin
X_CONTENT_TYPE_OPTIONS=nosniff
REFERRER_POLICY=no-referrer
X_XSS_PROTECTION=1; mode=block
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains; preload

# Push Notifications
# ---------------
# Optional
# Can be generated through https://vapidkeys.com/
VAPID_CONTACT=mailto:example@support.com
VAPID_PRIVATE_KEY=your_generated_private_vapid_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_generated_public_vapid_key
# Push Notification Configuration
NEXT_PUBLIC_NOTIFICATION_POLLING_INTERVAL_SECONDS=30
NEXT_PUBLIC_DISABLE_PUSH_NOTIFICATIONS=true

# Setup Steps
# ---------
# Optional
# You can add custom Setups steps to setup your own Tenant, a few are provided OOTB
# See ./scripts/setup
NEXT_SETUP_STEP_SERVICES=NotificationSetupStepService

# Build Settings
# ------------
# Optional
# OUTPUT Mode in next.config:
# - undefined/empty : for local
# - standlone : for docker or similar hosting setups
# - export :  for static self-hosting/cdn without NextJS)
NEXT_SERVER_OUTPUTMODE=
