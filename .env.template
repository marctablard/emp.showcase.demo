# =============================================================================
# SENSITIVE CONFIGURATION (Secrets, Passwords, Private Keys)
# These values should never be committed or shared
# =============================================================================

# Authentication & Security
# ------------------------
# Required
NEXTAUTH_SECRET=your_nextauth_secret
NEXT_PUBLIC_LOCALE_COOKIE=NEXT_LOCALE
NEXT_PUBLIC_SITE_COOKIE=NEXT_SITE

# Optional
# Set this if you want to use accounts that can be logged in through SSO
NEXT_SSO_PASSWORD_SECRET=your_sso_password_secret
NEXT_SETUP_API_SECRET=your_secure_setup_api_secret


# =============================================================================
# ENVIRONMENT-SPECIFIC CONFIGURATION
# Values that vary between environments but aren't sensitive
# =============================================================================

# Base URLs & Endpoints
# -----------------------
# Required - Set the protocol (HTTP/HTTPS) respective to the way you start your server
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Navigation (header / footer category menus)
# -----------------------
# Optional — max category links per column/footer slice before "Show all" (header flyout, footer products; default: 6)
NEXT_PUBLIC_NAVIGATION_ROOT_CATEGORIES_PAGE_SIZE=6

# Dependency Injection (DI)
# -----------------------
# Optional - Select environment-specific DI alias config:
# Uses src/platform/depency.<env>.yml when set (e.g. depency.production.yml)
DI_ENV=
# Optional - Explicit override path (absolute or relative to repo root)
# Example: src/platform/depency.local.yml
DI_DEPENDENCY_FILE=
# Optional - Build-time override for the SearchService alias during DI generation.
# Applied after dependency YAML and extension aliases. Regenerate/redeploy after changing it.
# Supported values: EmporixSearchService | BatteryIncludedSearchService
DI_SEARCH_SERVICE=
# Optional - When true, 1, or yes: `npm run generate` also emits src/platform/client.ts (browser Inversify).
# Omitted or any other value: default off (smaller bundles). ESLint allows @/platform/client only when enabled.
NEXT_PUBLIC_ENABLE_DI_GENERATE_CLIENT=

# Emporix Tenant & Client Configuration
# ------------------------
NEXT_PUBLIC_EMPORIX_BASE_URL=https://api.emporix.io
# Required - Public Storefront API Key (Emporix showcase tenant)
# A demo key is provided for convenience to ease the startup
NEXT_PUBLIC_EMPORIX_TENANT=showcase
NEXT_PUBLIC_EMPORIX_CLIENT_ID=eZKiPpY0THdB22MtNcXDuyTRxRxVZ6sD94baPpGoEeM0S0AR
# Server-side credentials (replace with your own for login/ordering)
NEXT_EMPORIX_CLIENT_ID=your_server_client_id
NEXT_EMPORIX_CLIENT_SECRET=your_server_client_secret
# Optional - The Storefront Client Secret is currently not used in any of the Emporix APIs
# but you can provide it for exposure to third party systems for future purposes
# !!! Security Note: you need to ensure yourself, that you are not exposing critical info through the Browser
NEXT_PUBLIC_EMPORIX_CLIENT_SECRET=your_client_secret_for_public_use

# Schema Management Credentials
# -----------------------
# Required for schema update operations (npm run update-schemas)
NEXT_EMPORIX_SCHEMA_CLIENT_ID=your_client_id_with_schema_and_custom_entity_management_permissions
NEXT_EMPORIX_SCHEMA_CLIENT_SECRET=your_schema_client_secret_for_schema_management

# Optional - Alternatively the token can be used 
EMPORIX_SCHEMA_ACCESS_TOKEN=your_emporix_access_token_with_schema_and_custom_entity_management_permissions


# Optional - Only required for automated API Testing
NEXT_EMPORIX_TEST_BASE_URL=https://api.emporix.io
NEXT_EMPORIX_TEST_TENANT=your_tenant_name
NEXT_EMPORIX_TEST_CLIENT_ID=your_storefront_client_id
NEXT_EMPORIX_TEST_SERVER_CLIENT_ID=your_server_client_id
# Test Environment Secrets
NEXT_EMPORIX_TEST_CLIENT_SECRET=your_storefront_client_secret
NEXT_EMPORIX_TEST_SERVER_CLIENT_SECRET=your_server_client_secret

# Optional - Battery Included
# -----------------------
# Runtime BI credentials and collection come from the Emporix indexing provider BATTERY_INCLUDED.
# Keep only the BI API base URL in storefront env.
NEXT_PUBLIC_BATTERY_INCLUDED_BASE_URL=https://api.batteryincluded.io

# === CMS Provider ===
# Optional - selects the active CMS plugin. SERVER-ONLY — must NOT carry a
# NEXT_PUBLIC_ prefix. The resolver runs on the server (instrumentation + DI),
# never in the browser bundle.
# Values: storyblok | local | none
#   storyblok — fetch CMS content from Storyblok (requires access token).
#   local     — load content from version-controlled JSON fixtures under
#               data/cms/. Dev/demo artefact, not a production source.
#   none      — NullCmsAdapter; app boots & renders an empty page shell.
# Empty (default) = auto-resolution: a Storyblok token below picks "storyblok",
# otherwise "none".
NEXT_CMS_PROVIDER=
# Optional - default site for the Local CMS adapter
# (data/cms/<site>/<lang>/<slug>.json). Used as a fallback when the
# requested site has no matching JSON file. SERVER-ONLY — must NOT carry a
# NEXT_PUBLIC_ prefix; only the LocalJsonCmsAdapter and the composite-fallback
# binder read it, both server-side.
NEXT_CMS_LOCAL_DEFAULT_SITE=_default_
# Optional - default-content fallback source. SERVER-ONLY — must NOT carry a
# NEXT_PUBLIC_ prefix.
# When set, the active CMS provider is wrapped in a composite that, whenever the
# provider has no content for a slug/layout/navigation, falls back to the named
# source queried against the `_default_` site (the version-controlled showcase
# tree under data/cms/_default_). This is what lets a fresh clone whose primary
# CMS space is still empty render the showcase instead of a blank shell.
# Values: mock (alias for "local") | local | empty.
# Empty = no composite layer (the primary provider binds directly). A value
# equal to the active primary is ignored (no self-wrap).
#
# ⚠ PRODUCTION: leave this EMPTY in production. The `mock` default below is a
# DEV/DEMO convenience so a fresh clone renders showcase content instead of a
# blank shell (AC #1). In production it would silently paper over real CMS
# content gaps with the version-controlled `_default_` demo tree, masking an
# empty/misconfigured primary space as "working". Production deploys set their
# env explicitly (Vercel, not this template) — keep this key unset there.
NEXT_CMS_FALLBACK_PROVIDER=mock

# Optional - Storyblok
# ------------------------
# A demo key is provided for convenience to ease the startup.
# The demo token + space id below resolve to the public "Emporix Showcase"
# Storyblok space (id 338074, verified via /v2/cdn/spaces/me).
# SERVER-ONLY — all four keys are read server-side only. The access token and
# preview switch are reached from the browser through server actions
# (`fetchTopBanner`, `getStoryblokBridgeConfig`); the env values themselves
# never cross to the client bundle. Do NOT re-introduce a `NEXT_PUBLIC_`
# prefix on any Storyblok key.
NEXT_STORYBLOK_ACCESS_TOKEN=uvTlxgRrZDSUyr4zftdoNgtt
NEXT_STORYBLOK_SPACE_ID=338074
NEXT_STORYBLOK_MULTI_SITE=false
NEXT_STORYBLOK_ACCESS_PREVIEW=true

# Optional - CMS webhook + content cache
# --------------------------------------
# Shared secret for verifying inbound CMS webhooks (HMAC-SHA-256 over the raw
# request body, `webhook-signature` header). SERVER-ONLY — must NOT carry a
# NEXT_PUBLIC_ prefix. When absent, POST /api/cms/webhook answers 503 (webhook
# deliberately disabled). The webhook is exempt from CSRF; this HMAC replaces it.
NEXT_CMS_WEBHOOK_SECRET=
# TTL (milliseconds) for the read-through CMS page / layout caches. Default 1h
# (3600000) each; non-positive or invalid values fall back to the default.
# SERVER-ONLY — the cache lives behind the `server-only`-marked cms-cache module.
NEXT_CMS_PAGE_CACHE_TTL_MS=3600000
NEXT_CMS_LAYOUT_CACHE_TTL_MS=3600000

# SSR Rendering Options
# ---------------------
# These flags enable SSR for specific Pages, Allowing for SEO-Optimization and call reduction on client-side
# Optional
NEXT_SSR_CART=true
NEXT_SSR_PRODUCT=true
NEXT_SSR_PRODUCT_PRICES=true
NEXT_SSR_PRODUCT_VARIANTS=true
NEXT_SSR_PRODUCT_STOCK=true
NEXT_SSR_PRODUCT_CATEGORIES=true
NEXT_SSR_SEARCH=true

# SSG Rendering Options
# ---------------------
# These flags enable SSG for specific Pages, Allowing for SEO-Optimization and call reduction on client-side
# Optional
# Set to 0 to disable SSG
NEXT_SSG_PRODUCT_COUNT=0

# =============================================================================
# GENERAL CONFIGURATION
# Default settings and feature flags
# =============================================================================

# System Defaults
# -------------
# Required
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
# When set: unknown site requests fall back to this site (redirect).
# When empty or omitted: unknown site requests show a 404 error page (no fallback).
# Optional — defaults to no fallback when empty.
NEXT_PUBLIC_DEFAULT_SITE=main
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_DEFAULT_COUNTRY=DE
NEXT_PUBLIC_DEFAULT_REGION=Europe
NEXT_PUBLIC_EMPORIX_DEFAULT_UNIT_CODE=piece
NEXT_PUBLIC_AVAILABLE_SITES=main,us-branch
# Optional: see docs/environment-variables.md — Emporix match-prices main-site fallback (true|1|yes).
# NEXT_PUBLIC_FALLBACK_PRICES=

# Optional
NEXT_PUBLIC_SITE_ROUTING_CONFIG=default
# this is only required if Proxy X-Forwarded Headers can't be properly set
NEXTAUTH_URL=http://localhost:3000

# Feature Flags & Settings
# ----------------------
# Optional (enable styleguide if either is true)
NEXT_STYLEGUIDE_PAGE=true
# NEXT_PUBLIC_STYLEGUIDE_PAGE=true
NEXT_ROBOTS_NOINDEX=false
NEXT_SETUP_API_ENABLED=false
# Local-only Playwright auth bootstrap for committed `*.local.spec.ts` scenarios.
# Keep disabled by default; the dedicated npm scripts enable it per run.
NEXT_E2E_LOCAL_AUTH_BOOTSTRAP_ENABLED=false
# Required when the local auth bootstrap lane is enabled. Use a random local-only shared secret.
# NEXT_E2E_LOCAL_AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-local-token
NEXT_CART_STOCK_CHECK_ENABLED=true
# Controls runtime startup healthcheck (Tier 2: remote API validation of sites, currencies, languages).
# Build-time env var validation (Tier 1) always runs and cannot be disabled.
NEXT_STARTUP_HEALTHCHECK_ENABLED=true
# Dialog close-on-outside-click behavior.
# When 'true', dialogs close when clicking outside (standard Radix behavior).
# When absent or any other value, outside-click close is disabled (users must use X or Cancel buttons).
# Individual dialogs can override via the closeOnOutsideClick prop on DialogContent.
# NEXT_PUBLIC_DIALOGS_CLOSE_ON_OUTSIDE_CLICK=true
# Optional — when true, product search omits catalog-root `categoryIds` from Emporix `q`.
# Use only for tenants where catalog `categoryIds` are missing or unusable; can widen search scope.
# NEXT_PUBLIC_SEARCH_OMIT_CATALOG_CATALOG_FILTER=false
# NEXT_AI_CHAT_STREAMING=false

# Logging (server-side Pino)
# ------------------------
# Optional — minimum server log level (trace|debug|info|warn|error|fatal).
# Defaults: debug in development, info in production.
# NEXT_LOG_LEVEL=info
# Optional — exact string "true" enables OpenTelemetry-aligned JSON on Node.js Pino stdout.
# Server-only (never NEXT_PUBLIC_). Default off. Restart the process after changing.
# NEXT_LOG_OTEL_ENABLED=true

# Prometheus Metrics
# ----------------
# Optional — set to "true" to enable metrics collection and the /metrics/prometheus endpoint
# NEXT_METRICS_ENABLED=true
# Optional — port for the metrics HTTP server (default: 3001)
# NEXT_MONITORING_PORT=3001
# Optional — controls which metric categories are collected and exposed:
#   both      — (default) all default process/node metrics + app counters + app histograms
#   counter   — app counters only (emx_bff_*_total) — no default metrics, no histograms
#   histogram — app histograms only (emx_bff_*_duration) — no default metrics, no counters
#   app       — all app metrics (counters + histograms) — no default process/node metrics
#   default   — default process/node metrics only — no app metrics
# NEXT_MONITORING_TYPE=both

# Debug Settings
# ------------
# Optional
NEXT_PUBLIC_DEBUG_API_CURL=false
NEXT_PUBLIC_DEBUG_API_VERBOSE=false
NEXT_PUBLIC_DEBUG_API_ENDPOINTS=
NEXT_PUBLIC_DEBUG_API_RESPONSE=OFF

# Storage Configuration
# -------------------
# Optional
NEXT_PUBLIC_HISTORY_STORAGE_NAME=history-storage
NEXT_PUBLIC_MAX_SEARCH_HISTORY=10
NEXT_PUBLIC_MAX_LAST_SEEN_PRODUCTS=12

# Rate Limiting
# -----------
# Optional
RATE_LIMIT=60
RATE_WINDOW=60

# Security Headers
# --------------
